{
  "id": "secret-santa",
  "contexts": [
    "household",
    "shared_space"
  ],
  "name": "Secret Santa",
  "version": "1.2.0",
  "description": "Gift exchanges with a truly secret draw — names are matched on the server, so nobody, the organizer included, can peek at who has whom. Don’t-pair rules keep couples from drawing each other. Budgets, gift hints, private idea notes, wishlist hop, and a one-tap full reveal.",
  "entrypoint": "index.html",
  "runtime": "static",
  "category": "family",
  "tags": [
    "gifts",
    "secret santa",
    "gift exchange",
    "holidays",
    "office party"
  ],
  "data_access": {
    "reads": [
      "family.members"
    ],
    "writes": []
  },
  "permissions": {
    "default_audience": "everyone",
    "requires_approval": false
  },
  "storage": "db",
  "db_plaintext_columns": [
    "exchange_date",
    "visibility"
  ],
  "member_references": {
    "exchanges": {
      "column": "created_by",
      "on_removed": "keep"
    },
    "participants": {
      "column": "member_id",
      "on_removed": "delete"
    },
    "assignments": [
      {
        "column": "giver_id",
        "on_removed": "delete"
      },
      {
        "column": "receiver_id",
        "on_removed": "delete"
      }
    ],
    "gift_notes": {
      "column": "member_id",
      "on_removed": "delete"
    },
    "exclusions": [
      {
        "column": "member_a_id",
        "on_removed": "delete"
      },
      {
        "column": "member_b_id",
        "on_removed": "delete"
      },
      {
        "column": "created_by",
        "on_removed": "keep"
      }
    ]
  },
  "row_policies": {
    "exchanges": {
      "kind": "adult_writable"
    },
    "participants": {
      "kind": "owner_or_visibility",
      "member_column": "member_id",
      "visibility_column": "visibility",
      "everyone_values": [
        "everyone"
      ],
      "write_owner_only": true,
      "max_per_member": {
        "member_column": "member_id",
        "scope_columns": [
          "exchange_id"
        ],
        "limit": 1
      }
    },
    "assignments": {
      "kind": "sealed_until",
      "fk_column": "exchange_id",
      "parent_table": "exchanges",
      "writer_column": "giver_id",
      "parent_status_column": "status",
      "visible_parent_status_values": [
        "revealed"
      ],
      "endpoint_writes_only": true
    },
    "gift_notes": {
      "kind": "owner_only",
      "member_column": "member_id",
      "adults_bypass": false,
      "max_per_member": {
        "member_column": "member_id",
        "scope_columns": [
          "exchange_id"
        ],
        "limit": 1
      }
    },
    "exclusions": {
      "kind": "adult_writable"
    }
  },
  "delete_cascades": {
    "exchanges": [
      {
        "table": "participants",
        "foreign_key": "exchange_id"
      },
      {
        "table": "gift_notes",
        "foreign_key": "exchange_id"
      },
      {
        "table": "exclusions",
        "foreign_key": "exchange_id"
      }
    ]
  },
  "secret_draw": {
    "parent_table": "exchanges",
    "parent_status_column": "status",
    "draw_status_values": [
      "open",
      "drawn"
    ],
    "drawn_status_value": "drawn",
    "drawn_at_column": "drawn_at",
    "participant_table": "participants",
    "participant_scope_column": "exchange_id",
    "participant_member_column": "member_id",
    "assignments_table": "assignments",
    "assignment_scope_column": "exchange_id",
    "giver_column": "giver_id",
    "receiver_column": "receiver_id",
    "created_at_column": "created_at",
    "exclusions": {
      "table": "exclusions",
      "scope_column": "exchange_id",
      "member_a_column": "member_a_id",
      "member_b_column": "member_b_id"
    },
    "write_acl": {
      "require_role": "adult"
    }
  },
  "publishes": [
    "secret_santa.exchange_created",
    "secret_santa.exchange_cancelled"
  ],
  "publish_acls": {
    "secret_santa.exchange_created": {
      "require_role": "adult"
    },
    "secret_santa.exchange_cancelled": {
      "require_role": "adult"
    }
  },
  "suggested_automations": [
    {
      "title": "Put the gift exchange on the household calendar",
      "description": "When an exchange gets a date \u2014 or that date moves \u2014 put it on the shared calendar, where everyone already looks for what is happening that week. Only the exchange's name and day travel: who drew whom never leaves Secret Santa, and the details you typed stay here too. Editing the date moves the entry already there instead of adding a second one.",
      "trigger_event": "secret_santa.exchange_created",
      "target_app_id": "calendar",
      "action_id": "create_event",
      "param_map": {
        "title": {
          "kind": "payload_field",
          "value": "title"
        },
        "event_date": {
          "kind": "payload_field",
          "value": "exchange_date"
        },
        "source_ref_id": {
          "kind": "payload_field",
          "value": "source_ref_id"
        }
      }
    },
    {
      "title": "Take the gift exchange back off the calendar",
      "description": "The other half of the rule above, and it only does anything if you have that one. When an exchange is deleted, archived, or has its date cleared, the calendar entry it put there stops showing \u2014 instead of leaving a party on the calendar that nobody is having. Add both, or the entry outlives the exchange.",
      "trigger_event": "secret_santa.exchange_cancelled",
      "target_app_id": "calendar",
      "action_id": "retract_dated_event",
      "param_map": {
        "source_ref_id": {
          "kind": "payload_field",
          "value": "source_ref_id"
        }
      }
    }
  ],
  "nav": {
    "label": "Secret Santa"
  },
  "agenda": {
    "kind": "event",
    "label": "Gift exchange",
    "source": {
      "kind": "sql",
      "query": "SELECT id AS id, title AS title, NULLIF(details, '') AS subtitle, exchange_date AS when_at FROM app_secret_santa__exchanges WHERE exchange_date = :today ORDER BY created_at LIMIT 20"
    }
  },
  "glance": {
    "source": {
      "kind": "sql",
      "query": "SELECT title AS title, exchange_date AS happens_on FROM app_secret_santa__exchanges WHERE exchange_date IS NOT NULL AND exchange_date <> '' AND exchange_date >= :today ORDER BY exchange_date LIMIT 3"
    },
    "display": {
      "template": "list",
      "title": "title",
      "when": "happens_on"
    },
    "ambient_card": "countdown"
  },
  "resource_limits": {
    "max_db_bytes": 10485760
  },
  "icon": "🎅"
}
